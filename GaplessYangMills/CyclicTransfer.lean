module

public import GaplessYangMills.RealTransferSpectrum

/-!
# Transfer spectral weight of a vector

The spectrum on the closed cyclic subspace generated by a vector records
the spectral support of that vector. A gap on this subspace controls the
powers applied to the vector, with its entire vacuum component retained
as their limit.
-/

@[expose] public section

namespace GaplessYangMills

open Filter
open scoped InnerProductSpace Topology

noncomputable section

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

def transferCyclicSpace (T : H →L[ℝ] H) (u : H) : Submodule ℝ H :=
  (Submodule.span ℝ (Set.range fun n : ℕ => (T ^ n) u)).topologicalClosure

theorem transferCyclicSpace_closed (T : H →L[ℝ] H) (u : H) :
    IsClosed (transferCyclicSpace T u : Set H) :=
  Submodule.isClosed_topologicalClosure _

instance [CompleteSpace H] (T : H →L[ℝ] H) (u : H) : CompleteSpace (transferCyclicSpace T u) :=
  (transferCyclicSpace_closed T u).isComplete.completeSpace_coe

theorem mem_transferCyclicSpace (T : H →L[ℝ] H) (u : H) : u ∈ transferCyclicSpace T u := by
  apply Submodule.le_topologicalClosure
  apply Submodule.subset_span
  exact ⟨0, by simp⟩

theorem transferCyclicSpace_invariant (T : H →L[ℝ] H) (u : H) {v : H}
    (h : v ∈ transferCyclicSpace T u) : T v ∈ transferCyclicSpace T u := by
  have hc := (transferCyclicSpace_closed T u).preimage T.continuous
  apply (closure_minimal (s := (Submodule.span ℝ (Set.range fun n : ℕ => (T ^ n) u) : Set H)) _ hc) h
  change Submodule.span ℝ (Set.range fun n : ℕ => (T ^ n) u) ≤
    (transferCyclicSpace T u).comap T.toLinearMap
  apply Submodule.span_le.mpr
  rintro _ ⟨n, rfl⟩
  change T ((T ^ n) u) ∈ transferCyclicSpace T u
  apply Submodule.le_topologicalClosure
  apply Submodule.subset_span
  refine ⟨n + 1, ?_⟩
  change (T ^ (n + 1)) u = T ((T ^ n) u)
  rw [pow_succ', mul_apply_eq_comp]

def cyclicTransfer (T : H →L[ℝ] H) (u : H) :
    transferCyclicSpace T u →L[ℝ] transferCyclicSpace T u :=
  (T.comp (transferCyclicSpace T u).subtypeL).codRestrict _ fun v =>
    transferCyclicSpace_invariant T u v.property

theorem cyclicTransfer_positive (T : H →L[ℝ] H) (hT : T.IsPositive) (u : H) :
    (cyclicTransfer T u).IsPositive := by
  refine ⟨?_, ?_⟩
  · intro v w
    exact hT.isSymmetric v.val w.val
  · intro v
    exact hT.re_inner_nonneg_left v.val

theorem cyclicTransfer_norm_le (T : H →L[ℝ] H) (u : H) : ‖cyclicTransfer T u‖ ≤ ‖T‖ := by
  apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg T)
  intro v
  exact T.le_opNorm v.val

theorem cyclicTransfer_pow_val (T : H →L[ℝ] H) (u : H) (n : ℕ) (v : transferCyclicSpace T u) :
    ((cyclicTransfer T u ^ n) v).val = (T ^ n) v.val := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ', pow_succ', mul_apply_eq_comp, mul_apply_eq_comp]
    change T (((cyclicTransfer T u ^ n) v).val) = _
    rw [ih]

/-- Operator norm decay in the cyclic subspace gives a bound with the
original vector norm as its prefactor. -/
theorem exists_realTransfer_vector_limit [CompleteSpace H] (T : H →L[ℝ] H) (hT : T.IsPositive) (u : H) {r : ℝ}
    (hr₀ : 0 ≤ r) (hr₁ : r < 1) (hgap : spectrum ℝ (cyclicTransfer T u) ⊆ Set.Icc 0 r ∪ {1}) :
    ∃ w : H, Tendsto (fun n : ℕ => (T ^ n) u) atTop (𝓝 w) ∧
      ∀ n : ℕ, ‖(T ^ n) u - w‖ ≤ ‖u‖ * r ^ n := by
  let V := transferCyclicSpace T u
  let S := cyclicTransfer T u
  let v : V := ⟨u, mem_transferCyclicSpace T u⟩
  obtain ⟨P, hP, hNorm⟩ := exists_realTransfer_power_limit S
    (cyclicTransfer_positive T hT u).isSelfAdjoint hr₀ hr₁ hgap
  refine ⟨(P v).val, ?_, fun n => ?_⟩
  · have hc : Continuous (fun A : V →L[ℝ] V => (A v).val) :=
      continuous_subtype_val.comp (by fun_prop)
    have ht : Tendsto (fun n : ℕ => ((S ^ n) v).val) atTop (𝓝 (P v).val) :=
      hc.continuousAt.tendsto.comp hP
    simpa only [S, cyclicTransfer_pow_val] using ht
  · rw [← show ((S ^ n) v).val = (T ^ n) u from cyclicTransfer_pow_val T u n v]
    change ‖((S ^ n - P) v)‖ ≤ _
    calc
      _ ≤ ‖S ^ n - P‖ * ‖v‖ := (S ^ n - P).le_opNorm v
      _ ≤ r ^ n * ‖v‖ := mul_le_mul_of_nonneg_right (hNorm n) (norm_nonneg _)
      _ = _ := mul_comm _ _

end

end GaplessYangMills
